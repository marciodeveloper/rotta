{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotta.example/contracts/pre-registration-export-v1.schema.json",
  "title": "ROTTA pre-registration export row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "source_id", "applicant_type", "document",
    "business_name", "category", "description", "responsible_name", "email",
    "phone", "address_mode", "city", "state", "status",
    "privacy_notice_version", "source", "created_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "source_id": { "type": "string", "format": "uuid" },
    "applicant_type": { "enum": ["company", "professional"] },
    "document": { "type": "string", "pattern": "^[0-9]{11}([0-9]{3})?$" },
    "business_name": { "type": "string", "maxLength": 150 },
    "category": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 1000 },
    "responsible_name": { "type": "string", "maxLength": 150 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "phone": { "type": "string", "maxLength": 30 },
    "website": { "type": ["string", "null"], "maxLength": 2048 },
    "instagram": { "type": ["string", "null"], "maxLength": 100 },
    "address_mode": { "enum": ["public_address", "service_area"] },
    "postal_code": { "type": ["string", "null"], "maxLength": 20 },
    "street": { "type": ["string", "null"], "maxLength": 200 },
    "number": { "type": ["string", "null"], "maxLength": 30 },
    "complement": { "type": ["string", "null"], "maxLength": 100 },
    "neighborhood": { "type": ["string", "null"], "maxLength": 100 },
    "city": { "type": "string", "maxLength": 100 },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "service_area": { "type": ["string", "null"], "maxLength": 300 },
    "status": { "enum": ["pending_email_confirmation", "under_review", "approved", "rejected", "archived"] },
    "email_confirmed_at": { "type": ["string", "null"], "format": "date-time" },
    "privacy_notice_version": { "type": "string", "maxLength": 50 },
    "source": { "const": "prelaunch_web" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
