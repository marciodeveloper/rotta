{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotta.example/contracts/pre-registration-export-v1.schema.json",
  "title": "ROTTA pre-registration minimal operational export row v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "source_id", "applicant_type", "document_last_four",
    "business_name", "category", "responsible_name", "email", "phone", "city",
    "state", "status", "privacy_notice_version", "created_at"
  ],
  "properties": {
    "contract_version": { "const": "1.1" },
    "source_id": { "type": "string", "format": "uuid" },
    "applicant_type": { "enum": ["company", "professional"] },
    "document_last_four": { "type": "string", "pattern": "^[0-9]{4}$" },
    "business_name": { "type": "string", "maxLength": 160 },
    "category": { "type": "string", "maxLength": 100 },
    "responsible_name": { "type": "string", "maxLength": 160 },
    "email": { "type": "string", "format": "email", "maxLength": 254 },
    "phone": { "type": "string", "maxLength": 30 },
    "city": { "type": "string", "maxLength": 120 },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "status": { "enum": ["pending_email_confirmation", "under_review", "approved", "rejected", "archived"] },
    "email_confirmed_at": { "type": ["string", "null"], "format": "date-time" },
    "privacy_notice_version": { "type": "string", "maxLength": 50 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
