{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotta.serradev.com/contracts/pre-registration-media-import-v1.schema.json",
  "title": "ROTTA pre-registration media import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "pre_registration_id", "media_id", "type", "position", "alt_text", "checksum", "mime_type", "extension", "size_bytes", "width", "height", "status", "storage_disk", "storage_key", "thumbnail_storage_key", "rights_confirmed_at"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "pre_registration_id": {"type": "string", "format": "uuid"},
    "media_id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["logo", "cover", "gallery"]},
    "position": {"type": "integer", "minimum": 0, "maximum": 5},
    "alt_text": {"type": "string", "minLength": 1, "maxLength": 240},
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp"]},
    "extension": {"enum": ["jpg", "png", "webp"]},
    "size_bytes": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pending_review", "approved", "rejected", "quarantined"]},
    "storage_disk": {"type": "string"},
    "storage_key": {"type": "string"},
    "thumbnail_storage_key": {"type": "string"},
    "rights_confirmed_at": {"type": "string", "format": "date-time"}
  }
}
